# Production environment variables for GitHub Pages
# Supabase is not used in production, so we set dummy values to prevent errors
VITE_SUPABASE_URL=https://dummy.supabase.co
VITE_SUPABASE_ANON_KEY=dummy_key

# EmailJS Configuration (you'll need to set these as GitHub Secrets)
VITE_EMAILJS_SERVICE_ID=service_yu2ndoq
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here